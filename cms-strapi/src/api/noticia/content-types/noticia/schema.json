{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Noticias",
    "description": "Noticias y comunicados que se publican en /prensa/noticias. Para publicar una nueva: complete el título, la fecha, un resumen corto y el contenido, y presione Publicar. La imagen es opcional: si no la agrega, se usa la imagen institucional por defecto.",
    "mainField": "titulo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 250
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "fecha": {
      "type": "datetime",
      "required": true
    },
    "resumen": {
      "type": "text",
      "maxLength": 600
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "contenido": {
      "type": "richtext"
    },
    "categoria": {
      "type": "enumeration",
      "enum": [
        "noticia",
        "periodico"
      ],
      "default": "noticia",
      "required": true
    }
  }
}
