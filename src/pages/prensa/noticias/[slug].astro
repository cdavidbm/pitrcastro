---
import Base from '../../../layouts/Base.astro';
// Estilos propios de algunos comunicados. Antes venían dentro del markdown de
// cada noticia; se movieron a una hoja aparte porque la política de seguridad
// de contenido de producción no admite estilos incrustados.
import '../../../styles/noticias.css';
import { getNoticias, contenidoAHtml } from '../../../utils/noticias';

export async function getStaticPaths() {
  // Las noticias vienen del CMS. El cuerpo se convierte a HTML aquí, durante
  // la compilación, con el mismo motor que se usaba para los archivos de texto.
  const noticias = await getNoticias();

  return Promise.all(
    noticias.map(async (n) => ({
      params: { slug: n.slug },
      props: {
        title: n.titulo,
        date: n.fecha,
        image: n.imagen,
        excerpt: n.resumen,
        contenido: await contenidoAHtml(n.contenido),
        // El comunicado en PDF, si la noticia lo enlaza en su texto (carpeta de prensa).
        pdf: n.contenido.match(/\((\/documentos\/media\/prensa\/[^)\s]+?\.pdf)\)/i)?.[1] ?? null,
      },
    }))
  );
}

const { title, date, image, excerpt, contenido, pdf } = Astro.props;
const base = import.meta.env.BASE_URL;

const displayImage = image;

const formattedDate = new Date(date).toLocaleDateString('es-CO', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Base title={title} description={excerpt}>
  <article class="article">
    <div class="container container--narrow">
      <!-- Solo aparece al imprimir o guardar como PDF -->
      <div class="article__print-head" aria-hidden="true">
        <img src={`${base}images/logo-itrc.png`} alt="" />
        <span>Agencia del Inspector General de Tributos, Rentas y Contribuciones Parafiscales · www.itrc.gov.co</span>
      </div>

      <header class="article__header">
        <a href={`${base}prensa/noticias`} class="article__back">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
          Volver a noticias
        </a>

        <h1 class="article__title">{title}</h1>

        <div class="article__meta">
          <time datetime={date}>
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            {formattedDate}
          </time>
        </div>

      </header>

      <figure class="article__image">
        <img src={displayImage} alt={title} />
      </figure>

      <div class="article__content" set:html={contenido}></div>

      <footer class="article__footer">
        {pdf ? (
          <a class="article__pdf" href={pdf} download target="_blank" rel="noopener">
            <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
            Descargar PDF
          </a>
        ) : (
          <button type="button" class="article__pdf" data-descargar-pdf title="Se abrirá la ventana para guardar la noticia como PDF">
            <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
            Descargar PDF
          </button>
        )}

        <div class="article__share">
          <span>Compartir:</span>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${Astro.url}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en Facebook"
          >
            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
          </a>
          <a
            href={`https://twitter.com/intent/tweet?url=${Astro.url}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en Twitter"
          >
            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
          </a>
          <a
            href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + Astro.url)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Compartir en WhatsApp"
          >
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </footer>
    </div>
  </article>
</Base>

<style>
  .article {
    padding: var(--space-12) 0 var(--space-20);
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
  }

  .article__back:hover {
    color: var(--itrc-gold);
  }

  .article__header {
    margin-bottom: var(--space-8);
  }

  .article__title {
    font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--theme-text-muted);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-4);
  }

  .article__meta time {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .article__tag {
    padding: var(--space-1) var(--space-3);
    background: var(--theme-surface-alt);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    color: var(--theme-text-secondary);
  }

  .article__image {
    margin: 0 0 var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .article__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article__content {
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--theme-text);
  }

  .article__content :global(h2) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-size: var(--font-size-2xl);
  }

  .article__content :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: var(--font-size-xl);
  }

  .article__content :global(p) {
    margin-bottom: var(--space-5);
  }

  .article__content :global(ul),
  .article__content :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .article__content :global(li) {
    margin-bottom: var(--space-2);
  }

  .article__content :global(strong) {
    color: var(--theme-heading);
  }

  .article__footer {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--theme-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .article__pdf {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--itrc-gold);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--theme-heading);
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .article__pdf i { color: #dc3545; }
  .article__pdf:hover { background: var(--itrc-gold); color: var(--itrc-navy); }
  .article__pdf:hover i { color: var(--itrc-navy); }

  .article__print-head { display: none; }

  /* Versión para imprimir o guardar como PDF: solo la noticia, con el logo. */
  @media print {
    :global(body > :not(main)) { display: none !important; }
    .article { padding: 0; }
    .article__back, .article__footer { display: none !important; }
    .article__print-head {
      display: flex; align-items: center; gap: 12px;
      padding-bottom: 10px; margin-bottom: 18px;
      border-bottom: 2px solid #b38b40;
      font-size: 9pt; color: #333;
    }
    .article__print-head img { height: 48px; width: auto; }
    .article__title { font-size: 20pt; color: #002147; }
    .article__image { box-shadow: none; break-inside: avoid; }
    .article__image img { max-height: 9cm; width: auto; max-width: 100%; margin: 0 auto; }
    .article__content { font-size: 11pt; line-height: 1.5; color: #000; }
  }

  .article__share {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .article__share span {
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm);
  }

  .article__share a {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--theme-surface-alt);
    border-radius: var(--radius-full);
    color: var(--theme-text-secondary);
    transition: all var(--transition-base);
  }

  .article__share a:hover {
    background: var(--itrc-gold);
    color: var(--itrc-navy);
  }

  @media (max-width: 768px) {
    .article {
      padding: var(--space-8) 0 var(--space-12);
    }
  }
</style>

<script>
  // Las noticias sin comunicado propio se guardan como PDF desde el navegador.
  function initDescargarPdf() {
    document.querySelectorAll<HTMLButtonElement>('[data-descargar-pdf]').forEach((b) => {
      b.addEventListener('click', () => window.print());
    });
  }
  initDescargarPdf();
  document.addEventListener('astro:after-swap', initDescargarPdf);
</script>
