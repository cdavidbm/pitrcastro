// Código de color por eje (fondos institucionales de tarjeta + tinta oscura legible).
// Los colores se eligen accesibles sobre fondo claro (contraste >= 4.5) y armonizan
// con la paleta ITRC sin robar protagonismo al dorado y navy.
/** Token del eje para el atributo `data-eje`. El color no puede ir escrito en
 *  el HTML: la política de seguridad del proveedor bloquea esos estilos. */
function ejeToken(franja: string | undefined): string {
  if (!franja) return 'ninguno';
  if (franja.startsWith('APERTURA')) return 'apertura';
  const m = franja.match(/^EJE (I{1,3}V?|IV)\b/);
  return m ? m[1].toLowerCase() : 'ninguno';
}


