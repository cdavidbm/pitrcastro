<script>
  (function () {
    const dataEl = document.getElementById('bios-data');
    if (!dataEl) return;
    let bios: Record<string, {nombre: string; parrafos: string[]; foto_grande: string | null}> = {};
    try { bios = JSON.parse(dataEl.textContent || '{}'); } catch { return; }

    const modal = document.getElementById('bio-modal') as HTMLElement | null;
    if (!modal) return;
    const foto = document.getElementById('bio-modal-foto') as HTMLImageElement;
    const title = document.getElementById('bio-modal-title') as HTMLElement;
    const bioEl = document.getElementById('bio-modal-bio') as HTMLElement;
    const closeBtn = modal.querySelector('.bio-modal__close') as HTMLButtonElement;
    let lastTrigger: HTMLElement | null = null;

    function open(key: string, trigger: HTMLElement) {
      const b = bios[key];
      if (!b) return;
      lastTrigger = trigger;
      title.textContent = b.nombre;
      bioEl.innerHTML = '';
      for (const p of b.parrafos) {
        const el = document.createElement('p');
        el.textContent = p;
        bioEl.appendChild(el);
      }
      if (b.foto_grande) {
        foto.src = b.foto_grande;
        foto.alt = b.nombre;
        foto.style.display = '';
      } else {
        foto.removeAttribute('src');
        foto.style.display = 'none';
      }
      modal.classList.add('bio-modal--open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      modal.classList.remove('bio-modal--open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastTrigger) { lastTrigger.focus(); lastTrigger = null; }
    }

    document.querySelectorAll<HTMLElement>('[data-bio-key]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.bioKey;
        if (key) open(key, btn);
      });
    });
    modal.querySelectorAll<HTMLElement>('[data-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('bio-modal--open')) close();
    });
  })();
</script>

