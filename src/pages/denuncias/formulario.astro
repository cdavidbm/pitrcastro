---
import Base from '../../layouts/Base.astro';
import HeroPage from '../../components/HeroPage.astro';
import { resolveUrl } from '../../utils/url';

const base = import.meta.env.BASE_URL;

const breadcrumb = [
  { label: 'Inicio', href: base },
  { label: 'Presente su denuncia', href: resolveUrl('/denuncias-nuevo') },
  { label: 'Elija la entidad', href: resolveUrl('/denuncias-nuevo/entidades') },
  { label: 'Elija la conducta', href: resolveUrl('/denuncias-nuevo/conducta') },
  { label: 'Sus datos', href: resolveUrl('/denuncias-nuevo/denunciante') },
  { label: 'Describa los hechos' },
];

const entidadesInfo: Record<string, { nombre: string; logo: string }> = {
  dian:      { nombre: 'DIAN',      logo: '/images/entidades/dian.png' },
  coljuegos: { nombre: 'Coljuegos', logo: '/images/entidades/coljuegos.png' },
  ugpp:      { nombre: 'UGPP',      logo: '/images/entidades/ugpp.png' },
};

// Dos secciones. Las preguntas no se escriben aquí: cada conducta tiene las
// suyas en el sistema de /denuncias/, y el script las lee de allí al cargar.
const secciones = [
  {
    id: 'hechos',
    num: 1,
    titulo: 'Los hechos',
    subtitulo: 'Qué pasó, dónde, cuándo y quiénes intervinieron.',
    icon: 'fa-solid fa-calendar-day',
  },
  {
    id: 'revision',
    num: 2,
    titulo: 'Revisar y enviar',
    subtitulo: 'Confirme lo diligenciado antes de enviar.',
    icon: 'fa-solid fa-check-double',
  },
];

const totalSecciones = secciones.length;
---

<Base
  title="Describa los hechos — Presente su denuncia — Agencia ITRC"
  description="Formulario guiado para describir la conducta disciplinaria que va a denunciar, con guardado automático de su avance."
>
  <HeroPage
    title="Describa los hechos"
    subtitle="Responda las preguntas sobre lo ocurrido. Sus respuestas se guardan automáticamente en este equipo mientras completa el formulario."
    icon="fa-solid fa-file-lines"
    breadcrumb={breadcrumb}
  />

  <!-- Progreso maestro del flujo -->
  <section class="paso-indicador" aria-label="Progreso del proceso">
    <div class="container">
      <ol class="paso-indicador__list">
        <li class="paso-indicador__item paso-indicador__item--completado">
          <span class="paso-indicador__num" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
          <span class="paso-indicador__label">Entidad</span>
        </li>
        <li class="paso-indicador__item paso-indicador__item--completado">
          <span class="paso-indicador__num" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
          <span class="paso-indicador__label">Conducta</span>
        </li>
        <li class="paso-indicador__item paso-indicador__item--completado">
          <span class="paso-indicador__num" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
          <span class="paso-indicador__label">Sus datos</span>
        </li>
        <li class="paso-indicador__item paso-indicador__item--activo" aria-current="step">
          <span class="paso-indicador__num">4</span>
          <span class="paso-indicador__label">Describa los hechos</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Chip contexto: entidad + conducta -->
  <section class="contexto-band" aria-label="Contexto de la denuncia">
    <div class="container">
      <div class="contexto-chips">
        <div class="entidad-chip" data-entidad-chip hidden>
          <span class="entidad-chip__label">Contra servidor de</span>
          <div class="entidad-chip__logo-wrap">
            {Object.entries(entidadesInfo).map(([slug, info]) => (
              <img
                class="entidad-chip__logo"
                data-entidad-logo={slug}
                src={resolveUrl(info.logo)}
                alt={`Logo ${info.nombre}`}
                hidden
              />
            ))}
          </div>
        </div>
        <div class="conducta-chip" data-conducta-chip hidden>
          <i class="fa-solid fa-tag" aria-hidden="true"></i>
          <span class="conducta-chip__label">Conducta —</span>
          <strong data-conducta-nombre></strong>
          <a href={resolveUrl('/denuncias-nuevo/conducta')} class="conducta-chip__cambiar">Cambiar</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Wizard progreso interno -->
  <section class="wizard-progreso" aria-label="Progreso del formulario">
    <div class="container">
      <div class="wizard-progreso__cabecera">
        <span class="wizard-progreso__label">
          <span data-seccion-actual>1</span> de {totalSecciones} secciones
        </span>
        <span class="wizard-progreso__nombre" data-seccion-nombre>{secciones[0].titulo}</span>
      </div>
      <div class="wizard-progreso__barra" role="progressbar" aria-valuemin="0" aria-valuemax="100" data-progreso-barra aria-valuenow="20">
        <div class="wizard-progreso__fill"></div>
      </div>
      <ol class="wizard-progreso__pastilla-list">
        {secciones.map((s, idx) => (
          <li class={`wizard-pastilla ${idx === 0 ? 'wizard-pastilla--activa' : ''}`} data-pastilla={s.id}>
            <span class="wizard-pastilla__num">{s.num}</span>
            <span class="wizard-pastilla__label">{s.titulo}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Wizard body -->
  <section class="wizard" aria-labelledby="wizard-title">
    <div class="container">
      <h2 id="wizard-title" class="visually-hidden">Formulario de denuncia</h2>

      <form
        class="wizard-form"
        method="get"
        action={resolveUrl('/denuncias-nuevo/confirmacion')}
        data-wizard-form
        novalidate
        enctype="multipart/form-data"
      >
        <!-- ================ Sección 1 — Los hechos ================ -->
        <section class="seccion" data-seccion="hechos">
          <header class="seccion__header">
            <div class="seccion__icon" aria-hidden="true">
              <i class="fa-solid fa-calendar-day"></i>
            </div>
            <div>
              <h3 class="seccion__titulo">Los hechos</h3>
              <p class="seccion__sub">Responda con sus propias palabras; no hace falta usar lenguaje jurídico. Las preguntas marcadas con <span class="campo__req">*</span> son obligatorias.</p>
            </div>
          </header>

          <div class="aviso" data-aviso-carga role="status">
            <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
            <span>Cargando las preguntas…</span>
          </div>
          <div class="aviso aviso--error" data-aviso-error role="alert" hidden>
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span>
              No fue posible conectar con el sistema de denuncias. Intente de nuevo en unos minutos, o presente su denuncia en el <a href="/denuncias/entidades">formulario anterior</a>.
            </span>
          </div>
          <div class="aviso aviso--error" data-aviso-sin-datos role="alert" hidden>
            <i class="fa-solid fa-id-card" aria-hidden="true"></i>
            <span>
              Antes de describir los hechos, complete sus datos. <a href={resolveUrl('/denuncias-nuevo/denunciante')} data-link-datos>Ir a sus datos</a>
            </span>
          </div>

          <div class="preguntas" data-preguntas></div>
        </section>

        <!-- ================ Sección 2 — Revisar y enviar ================ -->
        <section class="seccion" data-seccion="revision" hidden>
          <header class="seccion__header">
            <div class="seccion__icon" aria-hidden="true">
              <i class="fa-solid fa-check-double"></i>
            </div>
            <div>
              <h3 class="seccion__titulo">Revisar y enviar</h3>
              <p class="seccion__sub">Ya casi terminamos. Revise lo diligenciado — puede volver atrás para ajustar.</p>
            </div>
          </header>

          <div class="revision-panel" data-revision-panel>
            <!-- Se llena por JS a partir del formulario -->
          </div>

          <label class="check-inline">
            <input type="checkbox" name="declara" required data-declara />
            <span>
              Declaro bajo la gravedad del juramento que la información suministrada es cierta según mi conocimiento, y que conozco que la presentación de denuncias con temeridad o mala fe puede generar responsabilidad legal.
            </span>
          </label>

          <div class="aviso aviso--error aviso--envio" data-aviso-envio role="alert" hidden>
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <span data-aviso-envio-texto></span>
          </div>
        </section>

        <!-- Piezas de las preguntas. El script las clona: así lo que se dibuja
             después de cargar lleva los mismos estilos que el resto de la página. -->
        <template data-tpl="pregunta"><div class="pregunta"></div></template>
        <template data-tpl="opciones">
          <fieldset class="campo campo--opciones">
            <legend class="campo__label"></legend>
            <div class="radio-inline"></div>
          </fieldset>
        </template>
        <template data-tpl="opcion">
          <label class="radio-inline__opt"><input type="radio" data-persist /><span></span></label>
        </template>
        <template data-tpl="texto">
          <div class="campo"><label class="campo__label"></label><input class="campo__input" type="text" data-persist /></div>
        </template>
        <template data-tpl="parrafo">
          <div class="campo"><label class="campo__label"></label><textarea class="campo__input campo__input--textarea" rows="5" data-persist></textarea></div>
        </template>
        <template data-tpl="fecha">
          <div class="campo"><label class="campo__label"></label><input class="campo__input campo__input--fecha" type="date" data-persist /></div>
        </template>
        <template data-tpl="archivo">
          <div class="campo">
            <label class="campo__label"></label>
            <div class="dropzone" data-dropzone>
              <input class="dropzone__input" type="file" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.avi,.zip" data-file-input />
              <div class="dropzone__body">
                <i class="fa-solid fa-cloud-arrow-up dropzone__icon" aria-hidden="true"></i>
                <p class="dropzone__prompt">Arrastre un archivo aquí o <strong>haga clic para seleccionar</strong></p>
                <p class="dropzone__hint">JPG, PNG, PDF, Word, AVI o ZIP. Un archivo de hasta 20 MB.</p>
              </div>
            </div>
            <ul class="dropzone__list" data-file-list></ul>
          </div>
        </template>
        <template data-tpl="archivo-item">
          <li class="dropzone__file"><i class="fa-solid fa-file" aria-hidden="true"></i><span class="dropzone__file-name"></span><span class="dropzone__file-size"></span></li>
        </template>
        <template data-tpl="requerido"><span class="campo__req" aria-label="obligatorio"> *</span></template>
        <template data-tpl="nota"><small class="campo__hint"></small></template>
        <template data-tpl="error"><small class="campo__error"></small></template>
        <template data-tpl="revision-item">
          <div class="revision-item"><span class="revision-item__label"></span><span class="revision-item__value"></span></div>
        </template>

        <!-- ================ Botonera del wizard ================ -->
        <div class="wizard-nav">
          <button type="button" class="btn-secundario" data-btn-prev hidden>
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Anterior
          </button>
          <div class="wizard-nav__spacer" aria-hidden="true"></div>
          <span class="wizard-nav__guardado" data-guardado>Su avance se guarda automáticamente</span>
          <button type="button" class="btn-primario" data-btn-next disabled>
            Siguiente
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
          <button type="submit" class="btn-primario btn-primario--send" data-btn-submit hidden disabled>
            <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
            Enviar denuncia
          </button>
        </div>
      </form>
    </div>
  </section>
</Base>

<style>
  /* Reutilizado — barra de progreso maestro (mismo estilo que otros wizards) */
  .paso-indicador { background: var(--theme-surface-alt); padding: var(--space-4); border-bottom: 1px solid var(--theme-border-light); }
  .paso-indicador .container { max-width: 1000px; margin: 0 auto; }
  .paso-indicador__list { list-style: none; padding: 0; margin: 0; display: flex; align-items: center; justify-content: center; gap: var(--space-2); flex-wrap: wrap; }
  .paso-indicador__item { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); border-radius: var(--radius-full); color: var(--theme-text-muted); font-size: var(--font-size-sm); font-weight: 600; position: relative; }
  .paso-indicador__item::after { content: ''; display: inline-block; width: 24px; height: 1px; background: var(--theme-border); margin-left: var(--space-2); }
  .paso-indicador__item:last-child::after { display: none; }
  .paso-indicador__num { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--theme-surface); border: 1.5px solid var(--theme-border); font-size: 0.85rem; color: var(--theme-text-muted); font-weight: 700; }
  .paso-indicador__item--activo { background: var(--itrc-gold); color: var(--itrc-navy); }
  .paso-indicador__item--activo .paso-indicador__num { background: var(--itrc-navy); color: var(--itrc-gold); border-color: var(--itrc-navy); }
  .paso-indicador__item--completado .paso-indicador__num { background: var(--itrc-gold); color: var(--itrc-navy); border-color: var(--itrc-gold); }
  .paso-indicador__item--completado { color: var(--theme-heading); }

  /* Contexto (entidad + conducta) */
  .contexto-band { padding: var(--space-6) var(--space-4) 0; background: var(--theme-surface); }
  .contexto-band .container { max-width: 900px; margin: 0 auto; }
  .contexto-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .entidad-chip, .conducta-chip {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: 6px var(--space-3);
    background: var(--theme-surface-alt);
    border: 1px solid var(--theme-border-light);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    box-shadow: var(--shadow-sm);
  }
  .entidad-chip__label, .conducta-chip__label { color: var(--theme-text-muted); font-weight: 600; }
  .entidad-chip__logo-wrap { height: 22px; display: grid; place-items: center; }
  .entidad-chip__logo { max-height: 22px; max-width: 80px; width: auto; height: auto; object-fit: contain; }
  .conducta-chip i { color: var(--itrc-gold); font-size: 0.75rem; }
  .conducta-chip strong { color: var(--theme-heading); font-weight: 700; }
  .conducta-chip__cambiar { color: var(--itrc-gold-dark); text-decoration: none; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-full); }
  .conducta-chip__cambiar:hover { background: var(--theme-surface); text-decoration: underline; }

  /* ================ Wizard progreso interno ================ */
  .wizard-progreso { padding: var(--space-6) var(--space-4) var(--space-2); background: var(--theme-surface); }
  .wizard-progreso .container { max-width: 900px; margin: 0 auto; }
  .wizard-progreso__cabecera {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .wizard-progreso__label {
    font-size: 0.85rem;
    color: var(--theme-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .wizard-progreso__label span {
    color: var(--itrc-gold-dark);
    font-size: var(--font-size-lg);
    letter-spacing: 0;
  }
  .wizard-progreso__nombre {
    font-family: 'Nunito Sans', sans-serif;
    font-size: var(--font-size-xl);
    color: var(--theme-heading);
    font-weight: 800;
  }
  .wizard-progreso__barra {
    width: 100%;
    height: 6px;
    background: var(--theme-border-light);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .wizard-progreso__fill {
    height: 100%;
    width: 0;   /* el guion lo ajusta abajo */
    background: linear-gradient(90deg, var(--itrc-gold-dark), var(--itrc-gold));
    border-radius: var(--radius-full);
    transition: width 0.35s ease;
  }
  .wizard-progreso__pastilla-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: var(--space-2);
  }
  .wizard-pastilla {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px 4px 4px;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border-light);
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    color: var(--theme-text-muted);
    font-weight: 600;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }
  .wizard-pastilla__num {
    width: 22px; height: 22px;
    display: grid; place-items: center;
    background: var(--theme-surface-alt);
    color: var(--theme-text-muted);
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 800;
  }
  .wizard-pastilla--completada { border-color: var(--itrc-gold); color: var(--theme-heading); }
  .wizard-pastilla--completada .wizard-pastilla__num { background: var(--itrc-gold); color: var(--itrc-navy); }
  .wizard-pastilla--activa { background: var(--itrc-gold); border-color: var(--itrc-gold); color: var(--itrc-navy); }
  .wizard-pastilla--activa .wizard-pastilla__num { background: var(--itrc-navy); color: var(--itrc-gold); }

  /* ================ Wizard body ================ */
  .wizard { padding: var(--space-6) var(--space-4) var(--space-12); background: var(--theme-surface); }
  .wizard .container { max-width: 900px; margin: 0 auto; }

  .seccion {
    background: var(--theme-surface);
    border: 1px solid var(--theme-border-light);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .seccion[hidden] { display: none !important; }
  .seccion__header {
    display: flex; align-items: flex-start; gap: var(--space-4);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--theme-border-light);
  }
  .seccion__icon {
    width: 48px; height: 48px;
    display: grid; place-items: center;
    background: var(--itrc-gold);
    color: var(--itrc-navy);
    border-radius: 50%;
    font-size: 1.2rem;
    flex-shrink: 0;
  }
  .seccion__titulo {
    font-size: var(--font-size-xl);
    color: var(--theme-heading);
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .seccion__sub {
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.55;
    margin: 0;
  }

  /* Campos */
  .campo { display: flex; flex-direction: column; gap: 6px; margin-bottom: var(--space-4); }
  .campo:last-child { margin-bottom: 0; }
  .campo-grid { display: grid; gap: var(--space-4); margin-bottom: var(--space-4); }
  .campo-grid--2 { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .campo-grid .campo { margin-bottom: 0; }
  .campo__label { font-size: 0.85rem; color: var(--theme-heading); font-weight: 700; }
  .campo__req { color: var(--itrc-gold-dark); font-weight: 700; }
  .campo__input {
    padding: 10px 14px;
    font-family: inherit; font-size: var(--font-size-base);
    color: var(--theme-heading); background: var(--theme-surface);
    border: 1.5px solid var(--theme-border); border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .campo__input:hover { border-color: var(--theme-text-muted); }
  .campo__input:focus-visible {
    outline: none; border-color: var(--itrc-gold);
    box-shadow: 0 0 0 3px rgba(179, 139, 64, 0.18);
  }
  .campo__input--textarea { font-family: inherit; resize: vertical; min-height: 100px; line-height: 1.55; }
  .campo__hint { color: var(--theme-text-muted); font-size: 0.78rem; line-height: 1.4; }
  .campo__meta { display: flex; justify-content: space-between; gap: var(--space-2); }
  .campo__contador { color: var(--theme-text-muted); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

  /* Radio inline */
  .radio-inline { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .radio-inline__opt {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px;
    background: var(--theme-surface-alt);
    border: 1.5px solid var(--theme-border);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    color: var(--theme-text-secondary);
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }
  .radio-inline__opt:hover { border-color: var(--itrc-gold); }
  .radio-inline__opt input[type="radio"] { accent-color: var(--itrc-gold); cursor: pointer; }
  .radio-inline__opt:has(input:checked) {
    background: var(--itrc-gold);
    border-color: var(--itrc-gold);
    color: var(--itrc-navy);
    font-weight: 700;
  }

  /* Dropzone */
  .dropzone {
    position: relative;
    padding: var(--space-6);
    background: var(--theme-surface-alt);
    border: 2px dashed var(--theme-border);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: border-color var(--transition-fast), background var(--transition-fast);
  }
  .dropzone--drag { border-color: var(--itrc-gold); background: rgba(179, 139, 64, 0.05); }
  .dropzone__input {
    position: absolute; inset: 0;
    opacity: 0; cursor: pointer;
  }
  .dropzone__icon { font-size: 2rem; color: var(--itrc-gold); margin-bottom: var(--space-3); }
  .dropzone__prompt { color: var(--theme-heading); font-size: var(--font-size-base); margin: 0 0 var(--space-2); }
  .dropzone__prompt strong { color: var(--itrc-gold-dark); }
  .dropzone__hint { color: var(--theme-text-muted); font-size: 0.82rem; margin: 0; }
  .dropzone__list { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-direction: column; gap: 6px; }
  .dropzone__file {
    display: flex; align-items: center; gap: var(--space-3);
    padding: 8px 12px;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border-light);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
  }
  .dropzone__file i { color: var(--itrc-gold); }
  .dropzone__file-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--theme-heading); font-weight: 600; }
  .dropzone__file-size { color: var(--theme-text-muted); font-size: 0.78rem; font-variant-numeric: tabular-nums; }

  /* Panel revisión */
  .revision-panel {
    background: var(--theme-surface-alt);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--itrc-gold);
    margin-bottom: var(--space-5);
  }
  .revision-item {
    display: grid; grid-template-columns: minmax(140px, 200px) 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--theme-border-light);
    font-size: var(--font-size-sm);
  }
  .revision-item:last-child { border-bottom: none; }
  .revision-item__label { color: var(--theme-text-muted); font-weight: 600; }
  .revision-item__value { color: var(--theme-heading); word-break: break-word; }
  .revision-empty { color: var(--theme-text-muted); font-style: italic; }
  .asunto { margin-bottom: var(--space-5); }

  /* Check inline */
  .check-inline {
    display: flex; gap: var(--space-3); align-items: flex-start;
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm); line-height: 1.55;
    cursor: pointer;
  }
  .check-inline input[type="checkbox"] {
    flex-shrink: 0; width: 20px; height: 20px;
    accent-color: var(--itrc-gold);
    margin-top: 2px; cursor: pointer;
  }

  /* Botonera */
  .wizard-nav {
    display: flex; align-items: center; gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    margin-top: var(--space-6);
    border-top: 1px solid var(--theme-border-light);
  }
  .wizard-nav__spacer { flex: 1; }
  .wizard-nav__guardado {
    color: var(--theme-text-muted);
    font-size: 0.78rem;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .wizard-nav__guardado::before {
    content: ''; display: inline-block;
    width: 8px; height: 8px;
    background: var(--good, #5a7c4e);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .btn-primario, .btn-secundario {
    display: inline-flex; align-items: center; gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: inherit; font-size: var(--font-size-base); font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none; cursor: pointer;
    border: 2px solid transparent;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }
  .btn-primario { background: var(--itrc-gold); color: var(--itrc-navy); box-shadow: var(--shadow-md); }
  .btn-primario:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .btn-primario:focus-visible { outline: 3px solid var(--itrc-gold); outline-offset: 3px; }
  .btn-primario--send { background: var(--itrc-navy); color: var(--itrc-gold); }
  .btn-secundario { background: transparent; color: var(--theme-heading); border-color: var(--theme-border); }
  .btn-secundario:hover { background: var(--theme-surface-alt); border-color: var(--itrc-gold); }
  .btn-secundario:focus-visible { outline: 3px solid var(--itrc-gold); outline-offset: 3px; }

  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .btn-primario, .btn-secundario, .wizard-progreso__fill, .campo__input, .radio-inline__opt, .dropzone { transition: none; }
    .btn-primario:hover { transform: none; }
    .wizard-nav__guardado::before { animation: none; }
  }

  @media (max-width: 640px) {
    .paso-indicador__label { display: none; }
    .paso-indicador__item { padding: var(--space-1) var(--space-2); }
    .paso-indicador__item::after { width: 12px; margin-left: var(--space-1); }
    .wizard-pastilla__label { display: none; }
    .revision-item { grid-template-columns: 1fr; gap: 4px; }
    .revision-item__label { text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.06em; }
    .seccion { padding: var(--space-5) var(--space-4); }
    .wizard-nav { flex-direction: column-reverse; }
    .wizard-nav .btn-primario, .wizard-nav .btn-secundario { width: 100%; justify-content: center; }
    .wizard-nav__spacer, .wizard-nav__guardado { display: none; }
  }
  /* ============ Preguntas del sistema de /denuncias/ ============ */
  .preguntas { display: flex; flex-direction: column; gap: var(--space-4); }
  .pregunta {
    padding: var(--space-5);
    border: 1px solid var(--theme-border-light);
    border-radius: var(--radius-md);
    background: var(--theme-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .pregunta .campo { margin-bottom: 0; }
  .campo[hidden] { display: none; }
  .campo--opciones { border: 0; padding: 0; margin: 0; min-width: 0; }
  .campo--opciones .campo__label { padding: 0; margin-bottom: var(--space-2); line-height: 1.5; }
  .campo__label { line-height: 1.5; }
  .radio-inline--lista { flex-direction: column; align-items: stretch; }
  .radio-inline--lista .radio-inline__opt { border-radius: var(--radius-md); align-items: flex-start; }
  .radio-inline--lista .radio-inline__opt input[type="radio"] { margin-top: 3px; }
  .campo__input--fecha { max-width: 240px; }
  .campo__input[aria-invalid="true"] { border-color: #b83232; }
  .campo__error { display: block; color: #b83232; font-size: var(--font-size-sm); font-weight: 600; }

  .aviso {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--theme-border);
    background: var(--theme-surface-alt);
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }
  .aviso[hidden] { display: none; }
  .aviso i { color: var(--itrc-gold); margin-top: 3px; flex-shrink: 0; }
  .aviso--error { border-color: #d9a0a0; background: #fdf3f3; color: #7a2323; }
  .aviso--error i { color: #b83232; }
  .aviso a { color: inherit; font-weight: 700; }
  .aviso--envio { margin: var(--space-4) 0 0; }
  .btn-primario:disabled { opacity: 0.55; cursor: not-allowed; transform: none; box-shadow: none; }
</style>

<script>
  import {
    CORREO_CONTACTO,
    borrarDatos,
    cargarPreguntas,
    enviarDenuncia,
    esFormIdValido,
    leerDatos,
    type Control,
    type Pregunta,
  } from '../../utils/denuncias-legado';

  // ============ Datos del querystring ============
  const params = new URLSearchParams(window.location.search);
  const entidadSlug = params.get('entidad') || '';
  const conductaSlug = params.get('conducta') || '';
  const formId = params.get('form') || '';

  // Chip de entidad
  const entidadNombres: Record<string, string> = { dian: 'DIAN', coljuegos: 'Coljuegos', ugpp: 'UGPP' };
  const chipEnt = document.querySelector<HTMLElement>('[data-entidad-chip]');
  const logoActivo = document.querySelector<HTMLImageElement>(`[data-entidad-logo="${entidadSlug}"]`);
  if (chipEnt && logoActivo) { logoActivo.hidden = false; chipEnt.hidden = false; }

  // Chip de conducta
  const conductaNombres: Record<string, string> = {
    'peculado-apropiacion': 'Peculado por apropiación',
    'peculado-uso': 'Peculado por uso',
    'peculado-culposo': 'Peculado culposo',
    'concusion': 'Concusión',
    'cohecho': 'Cohecho',
    'prevaricato': 'Prevaricato',
    'falsedad-material': 'Falsedad material en documento público',
    'falsedad-ideologica': 'Falsedad ideológica en documento público',
    'abuso-funcion': 'Abuso de función pública',
    'trafico-influencias': 'Tráfico de influencias',
    'incremento-patrimonial': 'Incremento patrimonial no justificado',
    'indebida-celebracion': 'Indebida celebración de contratos',
    'general': 'Otra conducta disciplinaria',
  };
  const chipCond = document.querySelector<HTMLElement>('[data-conducta-chip]');
  const chipCondNombre = document.querySelector<HTMLElement>('[data-conducta-nombre]');
  if (chipCond && chipCondNombre && conductaNombres[conductaSlug]) {
    chipCondNombre.textContent = conductaNombres[conductaSlug];
    chipCond.hidden = false;
  }

  // ============ Piezas clonables ============
  const plantilla = <T extends Element>(nombre: string): T =>
    document.querySelector<HTMLTemplateElement>(`template[data-tpl="${nombre}"]`)!
      .content.firstElementChild!.cloneNode(true) as T;

  const contenedor = document.querySelector<HTMLElement>('[data-preguntas]')!;
  const avisoCarga = document.querySelector<HTMLElement>('[data-aviso-carga]');
  const avisoError = document.querySelector<HTMLElement>('[data-aviso-error]');
  const avisoSinDatos = document.querySelector<HTMLElement>('[data-aviso-sin-datos]');

  // Volver a los datos conserva lo elegido en los pasos anteriores.
  const linkDatos = document.querySelector<HTMLAnchorElement>('[data-link-datos]');
  if (linkDatos) {
    const url = new URL(linkDatos.href);
    url.search = new URLSearchParams({ entidad: entidadSlug, conducta: conductaSlug, form: formId }).toString();
    linkDatos.href = url.href;
  }

  // ============ Estado del wizard ============
  const seccionIds = ['hechos', 'revision'];
  const seccionTitulos: Record<string, string> = {
    'hechos': 'Los hechos',
    'revision': 'Revisar y enviar',
  };
  let indice = 0;

  const secciones = document.querySelectorAll<HTMLElement>('[data-seccion]');
  const pastillas = document.querySelectorAll<HTMLElement>('[data-pastilla]');
  const btnPrev = document.querySelector<HTMLButtonElement>('[data-btn-prev]');
  const btnNext = document.querySelector<HTMLButtonElement>('[data-btn-next]');
  const btnSubmit = document.querySelector<HTMLButtonElement>('[data-btn-submit]');
  const barraFill = document.querySelector<HTMLElement>('.wizard-progreso__fill');
  const barra = document.querySelector<HTMLElement>('[data-progreso-barra]');
  const seccionActualLabel = document.querySelector<HTMLElement>('[data-seccion-actual]');
  const seccionNombreLabel = document.querySelector<HTMLElement>('[data-seccion-nombre]');

  function mostrarSeccion(i: number) {
    secciones.forEach((s, idx) => { s.hidden = idx !== i; });
    pastillas.forEach((p, idx) => {
      p.classList.toggle('wizard-pastilla--activa', idx === i);
      p.classList.toggle('wizard-pastilla--completada', idx < i);
    });
    const pct = ((i + 1) / seccionIds.length) * 100;
    if (barraFill) barraFill.style.width = pct + '%';
    if (barra) barra.setAttribute('aria-valuenow', String(Math.round(pct)));
    if (seccionActualLabel) seccionActualLabel.textContent = String(i + 1);
    if (seccionNombreLabel) seccionNombreLabel.textContent = seccionTitulos[seccionIds[i]] || '';

    if (btnPrev) btnPrev.hidden = i === 0;
    if (btnNext) btnNext.hidden = i === seccionIds.length - 1;
    if (btnSubmit) btnSubmit.hidden = i !== seccionIds.length - 1;

    if (i === seccionIds.length - 1) renderRevision();

    // scroll suave al inicio del wizard
    document.querySelector('.wizard')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Punto de partida de la barra. Lo fijaba un estilo escrito en el HTML, que
  // la política de seguridad del proveedor bloquea. No se usa mostrarSeccion()
  // porque esa desplaza la página hasta el formulario.
  if (barraFill) barraFill.style.width = 100 / seccionIds.length + '%';

  const irA = (i: number) => {
    if (i > 0 && !validarHechos()) return;
    indice = i;
    mostrarSeccion(i);
  };

  btnNext?.addEventListener('click', () => { if (indice < seccionIds.length - 1) irA(indice + 1); });
  btnPrev?.addEventListener('click', () => { if (indice > 0) irA(indice - 1); });

  // Click en pastilla = ir a esa sección (solo si ya se pasó o es la próxima)
  pastillas.forEach((p, idx) => {
    p.style.cursor = 'pointer';
    p.addEventListener('click', () => { if (idx <= indice + 1) irA(idx); });
  });

  // ============ Preguntas del sistema de denuncias ============
  let preguntas: Pregunta[] = [];
  const controles = () => preguntas.flatMap(p => p.controles);

  // Las respuestas que piden narrar se escriben mejor en un área amplia.
  const PIDE_RELATO = /explique|describa|detallad|agregar/i;

  const sel = (nombre: string) => CSS.escape(nombre);

  function valorDe(nombre: string): string {
    const radios = contenedor.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${sel(nombre)}"]`);
    if (radios.length) return Array.from(radios).find(r => r.checked)?.value || '';
    const campo = contenedor.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${sel(nombre)}"]`);
    return campo && campo.type !== 'file' ? campo.value.trim() : '';
  }

  const aplica = (c: Control) => !c.dependeDe || c.activaCon.includes(valorDe(c.dependeDe));

  const textoVisible = (texto: string) => (texto === 'SI' ? 'Sí' : texto === 'NO' ? 'No' : texto);

  function etiquetar(label: Element, c: Control) {
    label.textContent = c.etiqueta || 'Respuesta';
    if (c.obligatorio) label.append(plantilla('requerido'));
  }

  function dibujarControl(c: Control): HTMLElement {
    const id = 'q-' + c.nombre;

    if (c.tipo === 'opciones') {
      const campo = plantilla<HTMLFieldSetElement>('opciones');
      etiquetar(campo.querySelector('legend')!, c);
      const grupo = campo.querySelector<HTMLElement>('.radio-inline')!;
      if (c.opciones.some(o => o.length > 24)) grupo.classList.add('radio-inline--lista');
      c.opciones.forEach((valor, i) => {
        const opcion = plantilla<HTMLLabelElement>('opcion');
        const input = opcion.querySelector('input')!;
        input.name = c.nombre;
        input.value = valor;
        opcion.querySelector('span')!.textContent = textoVisible(c.textosOpciones[i] || valor);
        grupo.append(opcion);
      });
      campo.dataset.control = c.nombre;
      return campo;
    }

    if (c.tipo === 'archivo') {
      const campo = plantilla<HTMLElement>('archivo');
      const label = campo.querySelector('label')!;
      label.textContent = 'Adjuntar archivo (opcional)';
      label.htmlFor = id;
      const input = campo.querySelector('input')!;
      input.id = id;
      input.name = c.nombre;
      prepararArchivo(campo, input);
      return campo;
    }

    const campo = plantilla<HTMLElement>(c.tipo === 'fecha' ? 'fecha' : PIDE_RELATO.test(c.etiqueta) ? 'parrafo' : 'texto');
    const label = campo.querySelector('label')!;
    etiquetar(label, c);
    label.htmlFor = id;
    const input = campo.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')!;
    input.id = id;
    input.name = c.nombre;
    campo.dataset.control = c.nombre;
    return campo;
  }

  // Los detalles ("¿Cuál?", "¿Quién es el tercero?") solo aparecen con la respuesta que los pide.
  function actualizarDependientes() {
    controles().forEach(c => {
      if (!c.dependeDe) return;
      const campo = contenedor.querySelector<HTMLElement>(`[data-control="${sel(c.nombre)}"]`);
      if (campo) campo.hidden = !aplica(c);
    });
  }

  function dibujar() {
    preguntas.forEach(p => {
      const tarjeta = plantilla<HTMLElement>('pregunta');
      p.controles.forEach(c => tarjeta.append(dibujarControl(c)));
      if (p.nota) {
        const nota = plantilla<HTMLElement>('nota');
        nota.textContent = p.nota;
        tarjeta.append(nota);
      }
      contenedor.append(tarjeta);
    });
    contenedor.addEventListener('change', actualizarDependientes);
    actualizarDependientes();

    // Al responder, desaparece el aviso de esa pregunta.
    const alResponder = (event: Event) => {
      const campo = (event.target as Element).closest<HTMLElement>('[data-control]');
      if (!campo) return;
      const nombre = campo.dataset.control || '';
      if (!valorDe(nombre)) return;
      campo.querySelectorAll('[data-error]').forEach(el => el.remove());
      campo.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));
    };
    contenedor.addEventListener('input', alResponder);
    contenedor.addEventListener('change', alResponder);
  }

  // ============ Adjunto: uno solo, como admite el sistema ============
  const TIPOS_PERMITIDOS = ['jpg', 'jpeg', 'png', 'pdf', 'doc', 'docx', 'avi', 'zip'];
  const TAMANO_MAXIMO = 20 * 1024 * 1024;
  let archivo: File | null = null;

  const tamanoLegible = (bytes: number) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  };

  function prepararArchivo(campo: HTMLElement, input: HTMLInputElement) {
    const dropzone = campo.querySelector<HTMLElement>('[data-dropzone]');
    const lista = campo.querySelector<HTMLElement>('[data-file-list]');

    input.addEventListener('change', () => {
      campo.querySelectorAll('[data-error]').forEach(el => el.remove());
      lista?.replaceChildren();
      const elegido = input.files?.[0] || null;
      const extension = elegido?.name.split('.').pop()?.toLowerCase() || '';

      if (elegido && (!TIPOS_PERMITIDOS.includes(extension) || elegido.size > TAMANO_MAXIMO)) {
        input.value = '';
        archivo = null;
        mostrarError(campo, elegido.size > TAMANO_MAXIMO
          ? 'El archivo supera los 20 MB.'
          : 'Ese tipo de archivo no está permitido. Use JPG, PNG, PDF, Word, AVI o ZIP.');
        return;
      }

      archivo = elegido;
      if (archivo && lista) {
        const item = plantilla<HTMLElement>('archivo-item');
        item.querySelector('.dropzone__file-name')!.textContent = archivo.name;
        item.querySelector('.dropzone__file-size')!.textContent = tamanoLegible(archivo.size);
        lista.append(item);
      }
    });

    // Solo resaltado: soltar el archivo lo recibe el propio campo, que cubre la zona.
    ['dragenter', 'dragover'].forEach(ev => dropzone?.addEventListener(ev, () => dropzone.classList.add('dropzone--drag')));
    ['dragleave', 'drop'].forEach(ev => dropzone?.addEventListener(ev, () => dropzone.classList.remove('dropzone--drag')));
  }

  // ============ Validación ============
  function mostrarError(campo: HTMLElement, mensaje: string) {
    const error = plantilla<HTMLElement>('error');
    error.dataset.error = '';
    error.textContent = mensaje;
    campo.append(error);
  }

  function validarHechos(): boolean {
    contenedor.querySelectorAll('[data-error]').forEach(el => el.remove());
    contenedor.querySelectorAll('[aria-invalid]').forEach(el => el.removeAttribute('aria-invalid'));

    let primero: HTMLElement | null = null;
    controles().forEach(c => {
      if (c.tipo === 'archivo' || !c.obligatorio || !aplica(c) || valorDe(c.nombre)) return;
      const campo = contenedor.querySelector<HTMLElement>(`[data-control="${sel(c.nombre)}"]`);
      if (!campo) return;
      mostrarError(campo, c.tipo === 'opciones' ? 'Elija una opción.' : 'Esta respuesta es obligatoria.');
      const foco = campo.querySelector<HTMLElement>('input, textarea');
      foco?.setAttribute('aria-invalid', 'true');
      if (!primero) primero = foco;
    });

    if (primero) {
      if (indice !== 0) { indice = 0; mostrarSeccion(0); }
      (primero as HTMLElement).focus({ preventScroll: true });
      (primero as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
      return false;
    }
    return true;
  }

  // ============ Persistencia (localStorage) ============
  // Clave nueva: los borradores del prototipo guardaban otras preguntas.
  const STORAGE_KEY = 'itrc-denuncia-v2-' + formId;
  try {
    Object.keys(localStorage)
      .filter(k => k.startsWith('itrc-denuncia-borrador-'))
      .forEach(k => localStorage.removeItem(k));
  } catch (_) {}

  function guardar() {
    const data: Record<string, string> = {};
    contenedor.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-persist]').forEach(el => {
      if (el.type === 'radio') {
        if ((el as HTMLInputElement).checked) data[el.name] = el.value;
      } else {
        data[el.name] = el.value;
      }
    });
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch (_) {}
  }

  function restaurar() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw) as Record<string, string>;
      contenedor.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-persist]').forEach(el => {
        const val = data[el.name];
        if (val === undefined) return;
        if (el.type === 'radio') {
          (el as HTMLInputElement).checked = el.value === val;
        } else {
          el.value = val;
        }
      });
    } catch (_) {}
  }

  // ============ Panel de revisión ============
  const formatoFecha = (iso: string) => {
    const [a, m, d] = iso.split('-');
    return a && m && d ? `${d}/${m}/${a}` : iso;
  };

  function renderRevision() {
    const panel = document.querySelector<HTMLElement>('[data-revision-panel]');
    if (!panel) return;
    panel.replaceChildren();

    const fila = (etiqueta: string, valor: string) => {
      const item = plantilla<HTMLElement>('revision-item');
      item.querySelector('.revision-item__label')!.textContent = etiqueta;
      const celda = item.querySelector<HTMLElement>('.revision-item__value')!;
      celda.textContent = valor || '—';
      if (!valor || valor === 'Ninguno') celda.classList.add('revision-empty');
      panel.append(item);
    };

    fila('Entidad', entidadNombres[entidadSlug] || '');
    fila('Conducta', conductaNombres[conductaSlug] || '');
    if (datos) fila('Quién denuncia', datos.tipo === 'anonimo' ? 'Denuncia anónima' : datos.NOMBRE);

    controles().forEach(c => {
      if (c.tipo === 'archivo') { fila('Archivo adjunto', archivo ? archivo.name : 'Ninguno'); return; }
      if (!aplica(c)) return;
      let valor = valorDe(c.nombre);
      if (c.tipo === 'opciones') valor = textoVisible(c.textosOpciones[c.opciones.indexOf(valor)] || valor);
      if (c.tipo === 'fecha') valor = formatoFecha(valor);
      fila(c.etiqueta, valor);
    });
  }

  // ============ Arranque ============
  const datos = leerDatos();

  if (!datos || !esFormIdValido(formId)) {
    if (avisoCarga) avisoCarga.hidden = true;
    if (avisoSinDatos) avisoSinDatos.hidden = false;
  } else {
    cargarPreguntas(formId)
      .then(resultado => {
        preguntas = resultado;
        dibujar();
        restaurar();
        actualizarDependientes();
        contenedor.addEventListener('input', guardar);
        contenedor.addEventListener('change', guardar);
        if (avisoCarga) avisoCarga.hidden = true;
        if (btnNext) btnNext.disabled = false;
        if (btnSubmit) btnSubmit.disabled = false;
      })
      .catch(() => {
        if (avisoCarga) avisoCarga.hidden = true;
        if (avisoError) avisoError.hidden = false;
      });
  }

  // ============ Envío ============
  const form = document.querySelector<HTMLFormElement>('[data-wizard-form]');
  const declara = document.querySelector<HTMLInputElement>('[data-declara]');
  const avisoEnvio = document.querySelector<HTMLElement>('[data-aviso-envio]');
  const avisoEnvioTexto = document.querySelector<HTMLElement>('[data-aviso-envio-texto]');
  const textoBoton = btnSubmit?.innerHTML || '';
  let enviando = false;

  const avisar = (mensaje: string) => {
    if (avisoEnvioTexto) avisoEnvioTexto.textContent = mensaje;
    if (avisoEnvio) avisoEnvio.hidden = false;
  };

  const CONTACTO = `escriba a ${CORREO_CONTACTO} o llame a la línea gratuita 01 8000 123 004`;
  const MENSAJES = {
    reintentar: 'No pudimos enviar su denuncia. Revise su conexión e intente de nuevo en unos minutos.',
    cambio: 'Las preguntas del sistema de denuncias cambiaron mientras completaba el formulario. Recargue la página, revise sus respuestas e intente de nuevo.',
    incierto: `Su denuncia llegó al sistema, pero no pudimos confirmar que quedara completa. Para no duplicarla, no la envíe de nuevo: ${CONTACTO}, indicando la fecha y hora del envío.`,
  };

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (enviando || !datos) return;
    if (avisoEnvio) avisoEnvio.hidden = true;
    if (!validarHechos()) return;
    if (!declara?.checked) {
      avisar('Para enviar la denuncia debe aceptar la declaración.');
      return;
    }

    const respuestas: Record<string, string> = {};
    controles().forEach(c => {
      if (c.tipo === 'archivo' || !aplica(c)) return;
      const valor = valorDe(c.nombre);
      if (valor) respuestas[c.nombre] = valor;
    });

    enviando = true;
    if (btnPrev) btnPrev.hidden = true;
    if (btnSubmit) {
      btnSubmit.disabled = true;
      btnSubmit.textContent = 'Enviando…';
    }

    const resultado = await enviarDenuncia(datos, formId, respuestas, archivo);

    if (resultado.ok) {
      try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
      borrarDatos();
      window.location.href = form.action;
      return;
    }

    if (resultado.reintentable) {
      avisar(resultado.motivo === 'cambio' ? MENSAJES.cambio : MENSAJES.reintentar);
      enviando = false;
      if (btnPrev) btnPrev.hidden = false;
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.innerHTML = textoBoton;
      }
    } else {
      // El envío pudo quedar registrado: no se ofrece repetirlo.
      avisar(MENSAJES.incierto);
      if (btnSubmit) btnSubmit.textContent = 'Envío detenido';
    }
  });
</script>
