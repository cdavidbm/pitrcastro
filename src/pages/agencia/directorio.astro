---
import Base from '../../layouts/Base.astro';
import HeroPage from '../../components/HeroPage.astro';
import { getAgenciaDirectorio } from '../../utils/strapi-fetchers';
import { resolveUrl } from '../../utils/url';
const pageData: any = (await getAgenciaDirectorio()) ?? {};
const base = import.meta.env.BASE_URL;

// Breadcrumb
const breadcrumb = [
  { label: 'Inicio', href: base },
  { label: 'Agencia', href: resolveUrl('/agencia') },
  { label: 'Directorio' }
];
---

<Base title={pageData.title} class="page-directorio" strapiSlug="agencia-directorio">
  <HeroPage
    title="Directorio"
    subtitle="Servidores y Contratistas de la Agencia ITRC"
    icon={pageData.icon}
    breadcrumb={breadcrumb}
  />

  <!-- Tarjetas de Directorio -->
  <section class="directorio-section" aria-labelledby="directorio-title">
    <div class="container">
      <h2 id="directorio-title" class="sr-only">Directorios disponibles</h2>

      <div class="directorio-grid">
        {pageData.directorios.map((dir) => (
          <a
            href={dir.url}
            class={`directorio-card directorio-card--${dir.color}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="directorio-card__icon">
              <i class={`fa-solid ${dir.icon}`} aria-hidden="true"></i>
            </div>
            <h3 class="directorio-card__titulo">
              {dir.titulo}
              {dir.external && (
                <i class="fa-solid fa-arrow-up-right-from-square external-icon" aria-hidden="true"></i>
              )}
            </h3>
            <p class="directorio-card__descripcion">{dir.descripcion}</p>
            <span class="directorio-card__action">
              {dir.external ? 'Ir al sitio' : 'Descargar PDF'}
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  /* Directorio Section */
  .directorio-section {
    padding: var(--space-16) var(--space-6);
    background: var(--theme-surface-alt);
  }

  .directorio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  .directorio-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-8);
    background: var(--theme-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .directorio-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }

  .directorio-card--navy::before {
    background: var(--theme-dark-section-bg);
  }

  .directorio-card--gold::before {
    background: var(--itrc-gold);
  }

  .directorio-card--green::before {
    background: var(--green-accent);
  }

  .directorio-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .directorio-card__icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-5);
    font-size: var(--font-size-3xl);
    transition: all var(--transition-base);
  }

  .directorio-card--navy .directorio-card__icon {
    background: rgba(21, 37, 63, 0.1);
    color: var(--theme-heading);
  }

  .directorio-card--gold .directorio-card__icon {
    background: rgba(var(--itrc-gold-rgb), 0.15);
    color: var(--itrc-gold);
  }

  .directorio-card--green .directorio-card__icon {
    background: rgba(5, 150, 105, 0.1);
    color: var(--green-accent);
  }

  .directorio-card:hover .directorio-card__icon {
    transform: scale(1.1);
  }

  .directorio-card--navy:hover .directorio-card__icon {
    background: var(--itrc-navy);
    color: var(--white);
  }

  .directorio-card--gold:hover .directorio-card__icon {
    background: var(--itrc-gold);
    color: var(--itrc-navy);
  }

  .directorio-card--green:hover .directorio-card__icon {
    background: var(--green-accent);
    color: var(--white);
  }

  .directorio-card__titulo {
    color: var(--theme-heading);
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .external-icon {
    font-size: var(--font-size-sm);
    opacity: 0.5;
  }

  .directorio-card__descripcion {
    color: var(--theme-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    margin-bottom: var(--space-5);
    flex-grow: 1;
  }

  .directorio-card__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--font-size-sm);
    transition: gap var(--transition-fast);
  }

  .directorio-card--navy .directorio-card__action {
    color: var(--theme-heading);
  }

  .directorio-card--gold .directorio-card__action {
    color: var(--itrc-gold);
  }

  .directorio-card--green .directorio-card__action {
    color: var(--green-accent);
  }

  .directorio-card:hover .directorio-card__action {
    gap: var(--space-3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .directorio-section {
      padding: var(--space-12) var(--space-4);
    }

    .directorio-card {
      padding: var(--space-6);
    }

    .directorio-card__icon {
      width: 64px;
      height: 64px;
      font-size: var(--font-size-2xl);
    }
  }
</style>
