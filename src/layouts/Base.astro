---
import '../styles/global.css';
import GovcoBar from '../components/layout/GovcoBar.astro';
import Header from '../components/layout/Header.astro';
import Navigation from '../components/layout/Navigation.astro';
import Footer from '../components/layout/Footer.astro';
import SocialBar from '../components/layout/SocialBar.astro';
import WcagWidget from '../components/WcagWidget.astro';
import AdminBar from '../components/AdminBar.astro';

import siteConfig from '../content/settings/site.json';
import contactConfig from '../content/settings/contact.json';

interface Props {
  title: string;
  description?: string;
  class?: string;
  // Identifica el content type de Strapi que alimenta esta página, para que
  // el AdminBar (visible solo si hay sesión Strapi) pueda enlazar al editor.
  // Ejemplo: strapiSlug="normativa-marco-legal" strapiKind="singleType"
  strapiSlug?: string;
  strapiKind?: 'singleType' | 'collectionType';
}

const {
  title,
  description = siteConfig.description,
  class: className = '',
  strapiSlug,
  strapiKind = 'singleType',
} = Astro.props;
const pageTitle = `${title} | ${siteConfig.name}`;
const base = import.meta.env.BASE_URL;

const schemaOrgData = {
  "@context": "https://schema.org",
  "@type": "GovernmentOrganization",
  name: siteConfig.name,
  legalName: siteConfig.fullName,
  url: siteConfig.url || "https://www.itrc.gov.co",
  logo: `${siteConfig.url || "https://www.itrc.gov.co"}${base}images/logo-itrc.png`,
  description: siteConfig.description,
  address: {
    "@type": "PostalAddress",
    streetAddress: contactConfig.address,
    addressLocality: contactConfig.city,
    postalCode: contactConfig.postalCode,
    addressCountry: "CO",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: contactConfig.phone,
      email: contactConfig.email,
      contactType: "customer service",
      areaServed: "CO",
      availableLanguage: ["Spanish"],
    },
    ...(contactConfig.tollFree ? [{
      "@type": "ContactPoint",
      telephone: contactConfig.tollFree,
      contactType: "toll-free",
      areaServed: "CO",
    }] : []),
  ],
  sameAs: Object.values(contactConfig.socialMedia || {}).filter(Boolean),
};
---

<!DOCTYPE html>
<!-- El tema institucional se aplica desde el servidor para que el sitio conserve
     su identidad visual aunque el script de preferencias no llegue a ejecutarse.
     Quien elija otro tema en el widget de accesibilidad lo verá reemplazado al cargar. -->
<html lang="es" class="theme-institucional">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="keywords" content={siteConfig.keywords?.join(', ')}>
  <meta name="author" content={siteConfig.name}>
  <meta name="robots" content="index, follow">

  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_CO">

  <!-- RSS feed -->
  <link rel="alternate" type="application/rss+xml" title={`Noticias — ${siteConfig.name}`} href={`${base}rss.xml`}>

  <!-- Schema.org — GovernmentOrganization -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)}></script>

  <title>{pageTitle}</title>

  <!-- Preferencias de accesibilidad guardadas por la persona (tema, tamaño de
       letra, contraste). Se aplican cuanto antes para evitar un parpadeo. -->
  <script src={`${base}js/preferencias.js`}></script>

  <!-- Iconos del sitio, generados a partir del escudo del logo institucional -->
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`}>
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
  <link rel="icon" type="image/png" sizes="512x512" href={`${base}icono-512.png`}>

  <!-- Font Awesome 6.5.1 servida desde el propio dominio. Se dejó de usar el CDN
       para no depender de terceros y cumplir la política de seguridad de contenido
       que el proveedor aplica en producción. Archivos en public/vendor/fontawesome/. -->
  <link rel="stylesheet" href={`${base}vendor/fontawesome/css/all.min.css`}>
</head>
<body class={className}>
  <a href="#main-content" class="skip-link">
    Saltar al contenido principal
  </a>

  <AdminBar slug={strapiSlug} kind={strapiKind} />

  <GovcoBar />
  <Header />
  <Navigation />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <Footer />
  <SocialBar />
  <WcagWidget />
  <script src={`${base}js/encabezado.js`}></script>
</body>
</html>
